{
  "name": "skunkworks-instructor-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "api-dist/api/functions.js",
  "scripts": {
    "dev": "vite",
    "validate:global-nav": "tsx scripts/validate-global-navigation.ts",
    "prebuild": "npm run validate:global-nav",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "provision:sharepoint": "tsx scripts/provision-sharepoint.ts",
    "provision:payments": "tsx scripts/provision-payment-sharepoint.ts",
    "provision:paypal": "tsx scripts/provision-paypal-subscriptions.ts",
    "teams:icons": "tsx scripts/generate-teams-icons.ts",
    "teams:validate": "tsx scripts/validate-teams-manifest.ts",
    "teams:validate:production": "tsx scripts/validate-teams-manifest.ts --production",
    "preview": "vite preview",
    "api:start": "func start --typescript",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.5.0",
    "@azure/msal-browser": "^3.30.0",
    "@azure/msal-react": "^2.2.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  }
}
